# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# Database. Leave unset to use the local Docker Postgres from docker-compose.yml.
# For a hosted Postgres that follows you across machines, paste its connection
# string. Prefer the direct (non-pooled) URL and require TLS, e.g.:
# DSN_DB=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# If you only have a pooled (PgBouncer-style) URL, append
# &default_query_exec_mode=exec so prepared statements aren't cached per connection.

# Optional overrides (defaults shown):
# DSN_SAVES=C:\Users\you\Documents\EA SPORTS College Football 27\Saves
# DSN_DATA=data
# DSN_ADDR=:8080
